{
  "name": "ניר הנדסה – יצירת דוח שטח",
  "short_name": "ניר הנדסה",
  "description": "יצירת דוחות שטח – עובד ללא אינטרנט",
  "theme_color": "#1e3a5f",
  "background_color": "#ffffff",
  "display": "standalone",
  "orientation": "portrait",
  "start_url": "/nir-reports/",
  "scope": "/nir-reports/",
  "lang": "he",
  "dir": "rtl",
  "icons": [
    { "src": "/nir-reports/icon-192-v2.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/nir-reports/icon-512-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/nir-reports/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "images", "accept": ["image/jpeg", "image/png", "image/webp", "image/gif"] }]
    }
  }
}

# Exact name of the WhatsApp chat to watch (a group or a saved contact name).
# Only messages from this one chat are read — everything else is ignored.
WHATSAPP_TARGET_CHAT=דוחות שטח

# Your Anthropic API key (console.anthropic.com → API Keys). Used to turn the
# raw WhatsApp text + photos into structured report data.
ANTHROPIC_API_KEY=sk-ant-...

# Send this in the watched chat to generate the report from everything sent
# since the last generate/reset. Optionally add a type: "צור דוח: סככות".
GENERATE_KEYWORD=צור דוח

# Send this to discard everything collected so far and start over.
RESET_KEYWORD=דוח חדש

# Send this + a type (e.g. "שאלון: סככות") to start a guided question flow
# instead of free typing — the bot asks one field at a time, numbered
# multiple-choice where relevant, free text always still accepted.
WIZARD_KEYWORD=שאלון

# Port the local status/QR API listens on.
PORT=3211

# Optional — override the document-validity dashboard's Google Sheet the
# wizard checks for past reports under a named client (see sheetLookup.js).
# Defaults to the same spreadsheet/key/tab nir-dashboard-new's dashboard.html
# itself reads with (a public, read-only-scoped API key, safe to ship in
# client-side code) — only set these if that sheet ever changes.
# DASHBOARD_SHEET_ID=1mZZq0QrQVqzNJ66ErJ-h81FSkO_5KIu3orePE5A9BqE
# DASHBOARD_API_KEY=AIzaSyDJy8tolZu8z-IuMFXSmRfsFFrM_rJkK8w
# DASHBOARD_SHEET_NAME=מסמכים
